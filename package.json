{
  "name": "workapp",
  "private": true,
  "version": "0.0.6",
  "main": "electron/main.mjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "electron": "set NODE_ENV=dev && electron .",
    "e:dev": "concurrently -k \"yarn dev\" \"yarn electron\"",
    "e:build": "set NODE_ENV=pro && vite build && electron-builder"
  },
  "dependencies": {
    "@varlet/ui": "^3.10.6",
    "esbuild-windows-64": "^0.15.18",
    "pinia": "^3.0.2",
    "sass": "^1.88.0",
    "vue": "^3.5.13",
    "vue-router": "4"
  },
  "devDependencies": {
    "@types/node": "^22.15.17",
    "@varlet/import-resolver": "^3.10.5",
    "@vitejs/plugin-vue": "^5.2.4",
    "concurrently": "^9.1.2",
    "electron": "^36.2.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.8.3",
    "unplugin-auto-import": "^19.2.0",
    "unplugin-vue-components": "^28.5.0",
    "vite": "^6.3.5",
    "vue-tsc": "^2.2.10"
  },
  "build": {
    "appId": "com.3417.github.io",
    "productName": "workbench",
    "copyright": "Copyright © 2022 Jone",
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "/public/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "extends": null,
    "directories": {
      "output": "epp"
    }
  }
}
